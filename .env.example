# Google OAuth2 credentials (from Google Cloud Console)
# Required for Nest SDM API access
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Nest Device Access Project ID
# Create at: https://console.nest.google.com/device-access
NEST_PROJECT_ID=your_nest_project_id_here

# OAuth2 tokens (populated after running auth flow)
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Optional: restrict speaker discovery to specific IP subnet
# CAST_NETWORK_INTERFACE=192.168.1.0/24
